# Copy this file to backend/.env on the VPS and customize as needed:
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of usernames granted Developer / Administrator access:
ADMIN_USERNAMES=nisal,nisal7410,admin

# Allowed frontend origins (comma-separated). Add your VPS IP/domain here:
# Example for VPS: CORS_ORIGIN=http://YOUR_VPS_IP:8080,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://147.93.112.99:8080

# Web Push VAPID Keys (run: node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log(k)")
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional Developer Header Key for direct curl/API database access (x-dev-key header):
# DEV_KEY=my-super-secret-dev-key
